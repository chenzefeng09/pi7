{
	"name": "pi-web",
	"private": true,
	"version": "0.1.0",
	"description": "Local desktop web UI for pi",
	"author": "chenzefeng <chenzefeng09@users.noreply.github.com>",
	"homepage": "https://github.com/chenzefeng09/pi7",
	"license": "MIT",
	"type": "module",
	"main": "dist/electron/main.cjs",
	"engines": {
		"node": ">=18.18.0"
	},
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit && vite build",
		"build:renderer": "vite build",
		"build:electron": "esbuild electron/main.ts --bundle --platform=node --target=node16 --format=cjs --outfile=dist/electron/main.cjs --external:electron && esbuild electron/preload.ts --bundle --platform=node --target=node16 --format=cjs --outfile=dist/electron/preload.cjs --external:electron",
		"check": "npm run typecheck && npm test && npm run build:electron && npm run build:renderer",
		"typecheck": "tsc --noEmit",
		"test": "vitest --run",
		"electron:dev": "npm run build:electron && concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
		"electron:start": "npm run build:electron && electron .",
		"prepare:resources": "node scripts/prepare-resources.mjs",
		"build:runtime": "node scripts/build-runtime.mjs",
		"package": "npm run prepare:resources && npm run build:electron && npm run build && electron-builder --win --dir",
		"package:zip": "npm run prepare:resources && npm run build:electron && npm run build && electron-builder --win zip"
	},
	"build": {
		"appId": "com.chenzefeng.piweb",
		"productName": "π7",
		"executableName": "pi7",
		"artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
		"files": [
			"build/icon.png",
			"dist/electron/**/*",
			"dist/renderer/**/*",
			"package.json"
		],
		"extraResources": [
			{
				"filter": [
					"**/*",
					"!config/agent/auth.json",
					"!config/agent/models-store.json",
					"!config/agent/sessions/**",
					"!config/agent/logs/**",
					"!config/agent/**/*.log",
					"!config/agent/extensions/*-test.ts"
				],
				"from": "resources/pi-win7",
				"to": "pi-win7"
			}
		],
		"win": {
			"target": [
				"zip",
				"nsis"
			]
		},
		"nsis": {
			"oneClick": false,
			"allowToChangeInstallationDirectory": true
		},
		"mac": {
			"target": [
				"zip",
				"dmg"
			],
			"category": "public.app-category.developer-tools"
		},
		"linux": {
			"target": [
				"AppImage",
				"deb",
				"zip"
			],
			"category": "Development"
		},
		"directories": {
			"output": "release"
		}
	},
	"dependencies": {
		"@keep-lts/xlsx": "0.18.6",
		"@radix-ui/react-dialog": "1.1.4",
		"@radix-ui/react-dropdown-menu": "2.1.4",
		"@radix-ui/react-select": "2.1.4",
		"@radix-ui/react-tooltip": "1.1.6",
		"@tanstack/react-virtual": "3.11.2",
		"clsx": "2.1.1",
		"docx-preview": "0.3.7",
		"libarchive.js": "2.0.2",
		"lucide-react": "0.468.0",
		"pptx-viewer": "0.2.2",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"react-markdown": "9.0.3",
		"remark-gfm": "4.0.0",
		"shiki": "1.29.2",
		"zod": "3.24.2",
		"zustand": "5.0.3"
	},
	"devDependencies": {
		"@types/node": "18.19.70",
		"@types/react": "18.3.18",
		"@types/react-dom": "18.3.5",
		"@types/ws": "8.5.13",
		"@vitejs/plugin-react": "4.3.4",
		"autoprefixer": "10.4.20",
		"concurrently": "9.1.2",
		"electron": "22.3.27",
		"electron-builder": "24.13.3",
		"esbuild": "0.24.2",
		"postcss": "8.4.49",
		"tailwindcss": "3.4.17",
		"typescript": "5.6.3",
		"vite": "6.0.7",
		"vitest": "3.0.5",
		"wait-on": "8.0.1",
		"ws": "8.18.0"
	}
}
